{
  "name": "slatesafe",
  "version": "1.0.0",
  "description": "SlateSafe - Modern Tablet Solutions",
  "scripts": {
    "build-css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch-css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "serve": "npx http-server . -p 8080 -o",
    "dev": "npx http-server . -p 8080",
    "test": "node --test api/checkout-lib.test.js api/create-checkout-session.test.js cart.test.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "stripe": "^23.0.0"
  }
}
